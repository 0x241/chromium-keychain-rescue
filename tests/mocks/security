#!/bin/bash
[[ "${1:-}" == list-keychains && "${2:-}" == -d && "${3:-}" == user ]] || exit 2
if [[ "${4:-}" == -s ]]; then
  shift 4
  printf 'SET' >> "$MOCK_SECURITY_LOG"
  printf '\t%s' "$@" >> "$MOCK_SECURITY_LOG"
  printf '\n' >> "$MOCK_SECURITY_LOG"
  exit 0
fi
printf '    "%s"\n' "$MOCK_CURRENT_KEYCHAIN"
if [[ -n "${MOCK_EXTRA_KEYCHAIN:-}" ]]; then
  printf '    "%s"\n' "$MOCK_EXTRA_KEYCHAIN"
fi
